# Copy to .env and fill in values before running

# API
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (used by docker-compose; override if using external DB)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/pt_adherence

# CORS — comma-separated list of allowed origins
# For local Expo dev add: exp://localhost:8081,http://localhost:8081
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081

# Mobile (Expo)
# API base URL seen from the device/simulator
EXPO_PUBLIC_API_URL=http://localhost:8000
