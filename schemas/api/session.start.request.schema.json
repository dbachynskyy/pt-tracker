{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.ptadherence.app/schemas/api/session.start.request.json",
  "title": "POST /sessions — Request Body",
  "description": "Opens a new rehab session for a patient on a given calendar date.",
  "type": "object",
  "required": ["userId", "date"],
  "additionalProperties": false,
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid",
      "description": "UUID of the authenticated patient"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Calendar date of the session in YYYY-MM-DD format (patient local date)"
    }
  },
  "examples": [
    {
      "userId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "date": "2026-03-02"
    }
  ]
}
